Temp = input("Enter the temperatures:")
Tnum = [int(n) for n in Temp.split()]

def calc_median_temperature(numbers):
    numbers = sorted(numbers)
    count = len(numbers)

    if count % 2 == 1:
        median = numbers[count // 2]
    else:
        middle1 = numbers[count // 2 - 1]
        middle2 = numbers[count // 2]
        median = (middle1 + middle2) / 2
    
    return median

print(f"Median temp is: {calc_median_temperature(Tnum)}")